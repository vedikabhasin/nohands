---
import { siteName, artistName, getCurrentExhibition, exhibitionPath } from '@/lib/exhibition';

const exhibition = getCurrentExhibition();
const home = exhibitionPath(exhibition);
---

<header class="site-header">
  <a class="wordmark chip" href={home} aria-label={`${siteName} home`}>{siteName}<span class="by">by {artistName}</span></a>
  <!-- Reserved: exhibition switcher renders here once more than one exhibition exists. -->
  <span class="chip">{exhibition.title}</span>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 clamp(1rem, 3vw, 2rem);
    pointer-events: none;
  }
  .site-header > * {
    pointer-events: auto;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    gap: 0.4rem;
  }
  .by {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--mute);
  }
  @media (max-width: 480px) {
    .by {
      display: none;
    }
  }
</style>
