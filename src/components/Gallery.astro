---
/**
 * The walk: one continuous corridor built with CSS 3D, assembled from short bays (one per
 * painting plus an entry and an end bay). Each bay is four small planes, so no layer is ever
 * huge or extends far behind the camera. Every plane, paintings included, is a direct child of
 * the scene: no nesting, which Safari composites reliably. Paintings alternate left and right,
 * Water Droplets first on the left by the door. The walk script sets the bay
 * positions and moves the camera; it also lays out the overlays. Reduced motion renders a flat
 * list instead.
 */
import FramedPainting from '@/components/FramedPainting.astro';
import PaintingDetails from '@/components/PaintingDetails.astro';
import { paintingPath, type Exhibition } from '@/lib/exhibition';

interface Props {
  exhibition: Exhibition;
}

const { exhibition } = Astro.props;
const stops = exhibition.works.map((work, i) => ({ work, side: i % 2 === 0 ? -1 : 1 }));
---

<div class="walk" data-walk={exhibition.id} data-count={stops.length}>
  <div class="stage" data-stage>
    <div class="scene" data-scene aria-hidden="true">
      <!-- Bays: four plain planes each. Every plane is a direct child of the scene (no wrappers),
           which is the structure Safari composites reliably. -->
      <div class="plane wall wall-l" data-bay="entry"></div>
      <div class="plane wall wall-r" data-bay="entry"></div>
      <div class="plane floor" data-bay="entry"></div>
      <div class="plane ceiling ceiling--plain" data-bay="entry"></div>
      {stops.map(({ work }) => (
        <>
          <div class="plane wall wall-l" data-bay={work.index}></div>
          <div class="plane wall wall-r" data-bay={work.index}></div>
          <div class="plane floor" data-bay={work.index}></div>
          <div class="plane ceiling" data-bay={work.index}></div>
        </>
      ))}
      <div class="plane wall wall-l" data-bay="end"></div>
      <div class="plane wall wall-r" data-bay="end"></div>
      <div class="plane floor" data-bay="end"></div>
      <div class="plane ceiling ceiling--plain" data-bay="end"></div>
      <div class="plane end-wall"></div>
      <!-- A soft pool of light on the wall behind each painting, then the painting itself. -->
      {stops.map(({ work, side }) => (
        <div class:list={['plane', 'pool', side < 0 ? 'hung-l' : 'hung-r']} data-pool={work.id} data-side={side}></div>
      ))}
      {stops.map(({ work, side }) => (
        <div
          class:list={['plane', 'hung', side < 0 ? 'hung-l' : 'hung-r']}
          data-hung={work.id}
          data-index={work.index}
          data-side={side}
          data-ratio={work.image.width / work.image.height}
          data-long={Math.max(work.originalSize.width, work.originalSize.height)}
        >
          <FramedPainting work={work} eager sizes="(min-width: 900px) 40vw, 84vw" />
        </div>
      ))}
    </div>

    <div class="overlays">
      <p class="intro-hint chip" data-intro-hint>
        {stops.length} works · scroll to walk
      </p>
      {stops.map(({ work }) => (
        <div class="panel" data-panel={work.id} style="--h: 0;">
          <h2 class="title title--mobile">{work.title}</h2>
          <div class="panel-details" data-details>
            <h2 class="title title--desktop" aria-hidden="true">{work.title}</h2>
            <PaintingDetails work={work} action="dialog" compact />
            <a class="page-link" href={paintingPath(work)}>View this work's page</a>
          </div>
        </div>
      ))}
      <nav class="walk-nav" aria-label="Move between works" data-walk-nav hidden>
        <button class="icon-btn" type="button" data-step="-1" aria-label="Previous work">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="icon-btn" type="button" data-step="1" aria-label="Next work">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </nav>
    </div>
  </div>

  <!-- Reduced motion: the same paintings and facts as a flat list. Images here only load when shown. -->
  <ol class="static-list" aria-label="Paintings">
    {stops.map(({ work }) => (
      <li class="static-item" id={`stop-${work.id}`}>
        <h2 class="title"><a href={paintingPath(work)}>{work.title}</a></h2>
        <div class="static-frame" style={`--ratio: ${work.image.width} / ${work.image.height};`}>
          <FramedPainting work={work} sizes="(min-width: 900px) 40vw, 84vw" />
        </div>
        <PaintingDetails work={work} action="dialog" />
      </li>
    ))}
  </ol>
</div>

<style>
  .walk {
    position: relative;
    /* height is set by the walk script */
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    -webkit-perspective: var(--p, 900px);
    perspective: var(--p, 900px);
    perspective-origin: 50% 50%;
    background: var(--ground);
    isolation: isolate;
  }
  .scene {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1px;
    height: 1px;
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
    will-change: transform;
  }
  /* Every plane is positioned from the scene origin: centre it, move it to its place, rotate. */
  .plane {
    position: absolute;
    left: 0;
    top: 0;
    -webkit-transform-style: flat;
    transform-style: flat;
  }
  /* Walls, floors and ceilings are drawn at a reduced size and scaled up by --ps (set by the
     walk script from the device pixel ratio), so every plane stays under Safari's tiled-layer
     threshold of 2048 device px. Tiled layers inside 3D scenes lose their rasterised content on
     iOS: only the solid background colour survives. At 1x screens --ps is 1, so nothing is
     upscaled and gradients stay clean. */
  .wall {
    width: calc(var(--len) / var(--ps, 1));
    height: calc(var(--ch) * 2 / var(--ps, 1));
    /* soft ivory with a gentle fall-off toward the floor; no pure white */
    background:
      linear-gradient(to bottom, rgba(255, 253, 247, 0.5), rgba(255, 253, 247, 0) 35%, rgba(20, 20, 19, 0.05)),
      var(--wall);
  }
  .pool {
    width: calc(var(--pw) * 2.4);
    height: calc(var(--pw) * 2.4);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 252, 244, 0.85), rgba(255, 252, 244, 0.35) 45%, rgba(255, 252, 244, 0) 100%);
  }
  .wall-l {
    transform: translate3d(-50%, -50%, 0) translate3d(calc(-1 * var(--cw)), 0, var(--zc)) rotateY(90deg) scale(var(--ps, 1));
  }
  .wall-r {
    transform: translate3d(-50%, -50%, 0) translate3d(var(--cw), 0, var(--zc)) rotateY(-90deg) scale(var(--ps, 1));
  }
  .hung {
    width: var(--pw);
  }
  .hung-l {
    transform: translate3d(-50%, -50%, 0) translate3d(calc(-1 * var(--cw) + 1.5px), 0, var(--zp)) rotateY(90deg);
  }
  .hung-r {
    transform: translate3d(-50%, -50%, 0) translate3d(calc(var(--cw) - 1.5px), 0, var(--zp)) rotateY(-90deg);
  }
  .floor {
    width: calc(var(--cw) * 2 / var(--ps, 1));
    height: calc(var(--len) / var(--ps, 1));
    transform: translate3d(-50%, -50%, 0) translate3d(0, var(--ch), var(--zc)) rotateX(90deg) scale(var(--ps, 1));
    background:
      linear-gradient(to right, rgba(20, 20, 19, 0.05), rgba(20, 20, 19, 0) 12%, rgba(20, 20, 19, 0) 88%, rgba(20, 20, 19, 0.05)),
      var(--floor);
  }
  .ceiling {
    width: calc(var(--cw) * 2 / var(--ps, 1));
    height: calc(var(--len) / var(--ps, 1));
    transform: translate3d(-50%, -50%, 0) translate3d(0, calc(-1 * var(--ch)), var(--zc)) rotateX(-90deg) scale(var(--ps, 1));
    background: var(--ceiling);
  }
  .ceiling--plain {
    background: var(--ceiling);
  }
  .end-wall {
    width: calc(var(--cw) * 2 / var(--ps, 1));
    height: calc(var(--ch) * 2 / var(--ps, 1));
    transform: translate3d(-50%, -50%, 0) translate3d(0, 0, var(--zend)) scale(var(--ps, 1));
    background: radial-gradient(60% 50% at 50% 30%, rgba(255, 253, 247, 0.9), var(--wall) 70%);
  }

  /* 2D overlays: one panel per painting, shown while the camera holds on it. */
  .overlays {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .panel {
    position: absolute;
    inset: 0;
    opacity: var(--h);
    pointer-events: none;
  }
  .intro-hint {
    position: absolute;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    opacity: var(--hint, 1);
    transition: opacity 400ms var(--ease);
  }
  .walk-nav {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    display: flex;
    gap: 0.5rem;
    pointer-events: auto;
    opacity: var(--nav, 0);
    transition: opacity 300ms var(--ease);
  }
  .walk-nav[hidden] {
    display: none;
  }
  @media (max-width: 899px) {
    /* On the phone the controls sit centred under the facts, in space the layout reserves. */
    .walk-nav {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      bottom: max(0.75rem, env(safe-area-inset-bottom));
    }
    .walk-nav .icon-btn {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
  .panel.is-view .panel-details {
    pointer-events: auto;
  }
  .title {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0;
    text-align: center;
  }
  .title--mobile {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    top: calc(var(--header-h) + 0.1rem);
    transform: translate3d(0, calc((1 - var(--h)) * -8px), 0);
  }
  .title--desktop {
    display: none;
  }
  .panel-details {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--details-top, 62%);
    padding: 0 1.25rem;
    transform: translate3d(0, calc((1 - var(--h)) * 14px), 0);
  }

  @media (min-width: 900px) {
    .title--mobile {
      display: none;
    }
    .title--desktop {
      display: block;
      font-size: 1.35rem;
      text-align: left;
      margin-bottom: 0.9rem;
    }
    .panel-details {
      left: auto;
      right: clamp(2rem, 7vw, 8rem);
      top: 50%;
      width: min(30rem, 38vw);
      padding: 0;
      transform: translate3d(calc((1 - var(--h)) * 14px), -50%, 0);
    }
    .panel-details :global(.details) {
      justify-items: start;
      text-align: left;
    }
    .panel-details :global(.facts li) {
      justify-content: flex-start;
    }
  }

  .page-link {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.74rem;
    color: var(--mute);
    text-align: center;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (min-width: 900px) {
    .page-link {
      text-align: left;
    }
  }
  .static-list {
    display: none;
    margin: 0;
    padding: calc(var(--header-h) + 1rem) 1.25rem 3rem;
    list-style: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .stage {
      display: none;
    }
    .walk {
      height: auto !important;
    }
    .static-list {
      display: grid;
      gap: 4rem;
    }
    .static-item {
      display: grid;
      gap: 1.25rem;
      justify-items: center;
      scroll-margin-top: var(--header-h);
    }
    .static-item .title {
      position: static;
      transform: none;
      margin: 0;
    }
    .static-frame {
      width: min(84vw, calc(50svh * (var(--ratio))), 36rem);
      margin-top: 4rem;
    }
  }
</style>
