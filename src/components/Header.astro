---
import { siteName, artistName, getCurrentExhibition, exhibitionPath, gridPath } from '@/lib/exhibition';

const exhibition = getCurrentExhibition();
const home = exhibitionPath(exhibition);
---

<header class="site-header">
  <a class="wordmark chip" href={home} aria-label={`${siteName} home`}>{siteName}<span class="by">by {artistName}</span></a>
  <!-- Reserved: exhibition switcher renders here once more than one exhibition exists. -->
  <nav class="right" aria-label="Exhibition">
    <a class="chip" href={home}>{exhibition.title}</a>
    <a class="chip chip--icon" href={gridPath(exhibition)} aria-label="All works as a grid">
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z" fill="currentColor"/></svg>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 clamp(1rem, 3vw, 2rem);
    pointer-events: none;
  }
  .site-header > * {
    pointer-events: auto;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    gap: 0.4rem;
  }
  .right {
    display: flex;
    gap: 0.4rem;
  }
  .chip--icon {
    padding: 0.4rem 0.7rem;
  }
  .by {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--mute);
  }
  @media (max-width: 599px) {
    .by,
    .right .chip:not(.chip--icon) {
      display: none;
    }
  }
</style>
