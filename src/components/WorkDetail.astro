---
/**
 * The purchase sheet (mode="panel", inside a <dialog> over the walk) and the purchase section of
 * /paintings/{id} (mode="page"): a small view of the painting, the facts, the options, Previous
 * and Next.
 */
import { Picture } from 'astro:assets';
import PurchaseOptions from '@/components/PurchaseOptions.astro';
import { altText, centimetres, inches, neighbours, paintingPath, widthsFor, type Exhibition, type Work } from '@/lib/exhibition';

interface Props {
  work: Work;
  exhibition: Exhibition;
  mode: 'panel' | 'page';
}

const { work, exhibition, mode } = Astro.props;
const { prev, next } = neighbours(exhibition, work);
const widths = widthsFor(work.image, [480, 720, 960, 1280], 1280);
---

<article class:list={['detail', `detail--${mode}`]} data-detail={work.id}>
  <div class="stage">
    <div class="stage-inner" style={`--ratio: ${work.image.width} / ${work.image.height};`}>
      <Picture
        src={work.image}
        widths={widths}
        sizes="(min-width: 900px) 32rem, 60vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={82}
        alt={altText(work)}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <p class="eyebrow">{exhibition.title} · {work.index + 1} of {exhibition.works.length}</p>
      {mode === 'panel' && (
        <button class="icon-btn close" type="button" data-close aria-label="Close and return to the gallery">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
        </button>
      )}
    </div>

    <header class="panel-title">
      <h2 class="title">{work.title}</h2>
      <p class="meta">{work.medium}</p>
      <p class="meta muted">{inches(work.originalSize)} <span aria-hidden="true">|</span> {centimetres(work.originalSize)}</p>
    </header>

    <PurchaseOptions work={work} />

    <nav class="walk-nav" aria-label="Move between paintings">
      {
        mode === 'panel' ? (
          <>
            <button class="nav-btn" type="button" data-prev={prev?.id ?? ''} disabled={!prev}>
              <span class="eyebrow">Previous</span>
              <span class="nav-title">{prev?.title ?? ''}</span>
            </button>
            <button class="nav-btn nav-next" type="button" data-next={next?.id ?? ''} disabled={!next}>
              <span class="eyebrow">Next</span>
              <span class="nav-title">{next?.title ?? ''}</span>
            </button>
          </>
        ) : (
          <>
            {prev ? (
              <a class="nav-btn" href={paintingPath(prev)}>
                <span class="eyebrow">Previous</span>
                <span class="nav-title">{prev.title}</span>
              </a>
            ) : (
              <span class="nav-btn" aria-disabled="true" />
            )}
            {next ? (
              <a class="nav-btn nav-next" href={paintingPath(next)}>
                <span class="eyebrow">Next</span>
                <span class="nav-title">{next.title}</span>
              </a>
            ) : (
              <span class="nav-btn" aria-disabled="true" />
            )}
          </>
        )
      }
    </nav>
  </div>
</article>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 0;
    background: var(--ground);
  }
  .stage {
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--ground-deep);
  }
  .stage-inner {
    width: min(100%, calc(60svh * (var(--ratio))));
    aspect-ratio: var(--ratio);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.6), 0 20px 50px -18px rgba(20, 20, 19, 0.4);
    background: var(--ground-low);
    outline: 1.5px solid rgba(20, 20, 19, 0.25);
    outline-offset: 10px;
  }
  .stage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .panel {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    padding: 1.25rem clamp(1.25rem, 3vw, 2.25rem) 2rem;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
  }
  .panel-title {
    display: grid;
    gap: 0.35rem;
  }
  .title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .meta {
    font-size: 0.92rem;
  }
  .meta span {
    margin: 0 0.35rem;
    color: var(--mute);
  }
  .walk-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .nav-btn {
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink);
  }
  .nav-next {
    text-align: right;
  }
  .nav-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .nav-btn:disabled,
  .nav-btn[aria-disabled='true'] {
    cursor: default;
    color: var(--mute);
  }
  .detail--page {
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }
  @media (max-width: 899px) {
    .detail {
      grid-template-columns: 1fr;
    }
    .stage {
      padding: 1.5rem 1.5rem 1.25rem;
    }
    .stage-inner {
      width: min(60vw, calc(34svh * (var(--ratio))));
    }
    .detail--panel .panel-head {
      position: sticky;
      top: 0;
      z-index: 2;
      margin: -1.25rem calc(-1 * clamp(1.25rem, 3vw, 2.25rem)) 0;
      padding: 0.75rem clamp(1.25rem, 3vw, 2.25rem);
      background: var(--ground);
    }
  }
</style>
