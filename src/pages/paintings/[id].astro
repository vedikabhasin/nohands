---
/**
 * Direct, indexable page for one painting: the framed painting with its facts, then the
 * purchase section, then a way into the walk at this painting.
 */
import Base from '@/layouts/Base.astro';
import FramedPainting from '@/components/FramedPainting.astro';
import PaintingDetails from '@/components/PaintingDetails.astro';
import WorkDetail from '@/components/WorkDetail.astro';
import { getExhibitions, inches, siteTagline, paintingPageTitle, paintingPath, walkPathAt, usd, priceFrom } from '@/lib/exhibition';

export function getStaticPaths() {
  return getExhibitions().flatMap((exhibition) =>
    exhibition.works.map((work) => ({ params: { id: work.id }, props: { work, exhibition } })),
  );
}

const { work, exhibition } = Astro.props;
const availability =
  work.status === 'sold'
    ? `Original sold. Fine art reproductions from ${usd(priceFrom(work))}.`
    : `Original ${usd(work.originalPrice)}, fine art reproductions from ${usd(priceFrom(work))}.`;
const description = `${work.title}, ${work.medium}, ${inches(work.originalSize)}. ${availability} Part of ${exhibition.title} at ${siteTagline}.`;
---

<Base title={paintingPageTitle(work)} description={description} canonical={paintingPath(work)}>
  <section class="painting">
    <div class="frame-wrap" style={`--ratio: ${work.image.width} / ${work.image.height};`}>
      <FramedPainting work={work} eager sizes="(min-width: 900px) 40vw, 84vw" />
    </div>
    <div class="facts details--left">
      <h1 class="title">{work.title}</h1>
      <PaintingDetails work={work} action="link" href="#buy" />
    </div>
  </section>
  <section class="buy-section" id="buy">
    <WorkDetail work={work} exhibition={exhibition} mode="page" />
    <p class="enter">
      <a class="pill" href={walkPathAt(exhibition, work)}>Enter the exhibition at this painting</a>
    </p>
  </section>
</Base>

<style>
  .painting {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 1rem) 1.25rem 3rem;
  }
  .title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
    text-align: center;
  }
  .frame-wrap {
    width: min(84vw, calc(42svh * (var(--ratio))));
    margin-top: 3.5rem;
  }
  .facts {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
  }
  @media (min-width: 900px) {
    .painting {
      grid-template-columns: 1fr minmax(0, 30rem);
      align-items: center;
      gap: clamp(2rem, 6vw, 6rem);
      padding-inline: clamp(2rem, 7vw, 8rem);
    }
    .frame-wrap {
      width: min(40vw, calc(60svh * (var(--ratio))));
      margin: 0;
      justify-self: center;
    }
    .facts {
      justify-items: start;
    }
    .title {
      font-size: 1.35rem;
      text-align: left;
    }
  }
  .buy-section {
    display: grid;
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1rem clamp(1rem, 3vw, 2rem) 4rem;
    scroll-margin-top: var(--header-h);
  }
  .enter {
    text-align: center;
  }
</style>
