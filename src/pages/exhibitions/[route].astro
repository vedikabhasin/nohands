---
/**
 * The gallery walk. Every painting's purchase sheet is pre-rendered in a <dialog> so buying
 * never leaves the page or loses the visitor's place.
 */
import Base from '@/layouts/Base.astro';
import Gallery from '@/components/Gallery.astro';
import WorkDetail from '@/components/WorkDetail.astro';
import { getExhibitions, siteTagline, exhibitionPath, usd, priceFrom } from '@/lib/exhibition';

export function getStaticPaths() {
  return getExhibitions().map((exhibition) => ({ params: { route: exhibition.route }, props: { exhibition } }));
}

const { exhibition } = Astro.props;
const description = `${exhibition.title} at ${siteTagline}: ${exhibition.works.length} original paintings on paper, walked one at a time. Originals and fine art reproductions from ${usd(Math.min(...exhibition.works.map(priceFrom)))}.`;
---

<Base title={`${exhibition.title} | ${siteTagline}`} description={description} canonical={exhibitionPath(exhibition)} bodyClass="is-walk">
  <h1 class="visually-hidden">{exhibition.title}</h1>

  <Gallery exhibition={exhibition} />

  <p class="indicator chip" aria-live="polite" data-indicator hidden>
    <span data-stop-current>1</span>&nbsp;/&nbsp;{exhibition.works.length}
  </p>

  {
    exhibition.works.map((work) => (
      <dialog class="sheet" id={`dialog-${work.id}`} data-dialog={work.id} aria-label={`${work.title}: source the original or order a reproduction`}>
        <WorkDetail work={work} exhibition={exhibition} mode="panel" />
      </dialog>
    ))
  }

  <script>
    import { initWalk } from '@/scripts/walk';
    initWalk();
  </script>
</Base>

<style>
  .indicator[hidden] {
    display: none;
  }
  .indicator {
    position: fixed;
    left: 50%;
    top: calc(var(--header-h) / 2);
    z-index: 10;
    transform: translate(-50%, -50%);
    margin: 0;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
  .sheet {
    width: min(100vw, 64rem);
    max-width: 100vw;
    max-height: 92svh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--ground);
    color: var(--ink);
    overflow: auto;
    box-shadow: var(--shadow-lift);
  }
  .sheet::backdrop {
    background: rgba(20, 20, 19, 0.45);
    backdrop-filter: blur(4px);
  }
  @media (max-width: 899px) {
    .sheet {
      margin: auto 0 0 0;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] {
      animation: sheet-in 420ms var(--ease);
    }
    @keyframes sheet-in {
      from {
        opacity: 0;
        transform: translateY(28px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
