---
/**
 * Direct, indexable page for one painting: the painting view, then the purchase section.
 */
import Base from '@/layouts/Base.astro';
import Stop from '@/components/Stop.astro';
import WorkDetail from '@/components/WorkDetail.astro';
import { getExhibitions, inches, siteTagline, paintingPageTitle, paintingPath, walkPathAt, usd, priceFrom } from '@/lib/exhibition';

export function getStaticPaths() {
  return getExhibitions().flatMap((exhibition) =>
    exhibition.works.map((work) => ({ params: { id: work.id }, props: { work, exhibition } })),
  );
}

const { work, exhibition } = Astro.props;
const availability =
  work.status === 'sold'
    ? `Original sold. Fine art reproductions from ${usd(priceFrom(work))}.`
    : `Original ${usd(work.originalPrice)}, fine art reproductions from ${usd(priceFrom(work))}.`;
const description = `${work.title}, ${work.medium}, ${inches(work.originalSize)}. ${availability} Part of ${exhibition.title} at ${siteTagline}.`;
---

<Base title={paintingPageTitle(work)} description={description} canonical={paintingPath(work)}>
  <Stop work={work} exhibition={exhibition} static buyHref="#buy" />
  <section class="buy-section" id="buy">
    <WorkDetail work={work} exhibition={exhibition} mode="page" />
    <p class="enter">
      <a class="pill" href={walkPathAt(exhibition, work)}>Enter the exhibition at this painting</a>
    </p>
  </section>
</Base>

<style>
  .buy-section {
    display: grid;
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1rem clamp(1rem, 3vw, 2rem) 4rem;
    scroll-margin-top: var(--header-h);
  }
  .enter {
    text-align: center;
  }
</style>
