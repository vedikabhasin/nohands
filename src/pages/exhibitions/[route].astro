---
/**
 * The gallery walk: one stop per painting in walk order. Every painting's purchase sheet is
 * pre-rendered in a <dialog> so buying never leaves the page or loses the visitor's place.
 */
import Base from '@/layouts/Base.astro';
import Stop from '@/components/Stop.astro';
import WorkDetail from '@/components/WorkDetail.astro';
import { getExhibitions, siteTagline, exhibitionPath, usd, priceFrom } from '@/lib/exhibition';

export function getStaticPaths() {
  return getExhibitions().map((exhibition) => ({ params: { route: exhibition.route }, props: { exhibition } }));
}

const { exhibition } = Astro.props;
const description = `${exhibition.title} at ${siteTagline}: ${exhibition.works.length} original paintings on paper, shown one at a time as a walk through the gallery. Originals and fine art reproductions from ${usd(Math.min(...exhibition.works.map(priceFrom)))}.`;
---

<Base title={`${exhibition.title} | ${siteTagline}`} description={description} canonical={exhibitionPath(exhibition)} bodyClass="is-walk">
  <h1 class="visually-hidden">{exhibition.title}</h1>

  <div class="walk" data-walk={exhibition.id}>
    {exhibition.works.map((work) => <Stop work={work} exhibition={exhibition} />)}
  </div>

  <p class="indicator chip" aria-live="polite">
    <span data-stop-current>1</span>&nbsp;/&nbsp;{exhibition.works.length}
  </p>

  {
    exhibition.works.map((work) => (
      <dialog class="sheet" id={`dialog-${work.id}`} data-dialog={work.id} aria-label={`Buy ${work.title}`}>
        <WorkDetail work={work} exhibition={exhibition} mode="panel" />
      </dialog>
    ))
  }

  <script>
    import { initWalk } from '@/scripts/walk';
    initWalk();
  </script>
</Base>

<style>
  :global(html:has(body.is-walk)) {
    scroll-snap-type: y proximity;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html:has(body.is-walk)) {
      scroll-snap-type: none;
    }
  }
  .indicator {
    position: fixed;
    left: 50%;
    top: calc(var(--header-h) / 2);
    z-index: 10;
    transform: translate(-50%, -50%);
    margin: 0;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
  .sheet {
    width: min(100vw, 64rem);
    max-width: 100vw;
    max-height: 92svh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--ground);
    color: var(--ink);
    overflow: auto;
    box-shadow: var(--shadow-lift);
  }
  .sheet::backdrop {
    background: rgba(20, 20, 19, 0.45);
    backdrop-filter: blur(4px);
  }
  @media (max-width: 899px) {
    .sheet {
      margin: auto 0 0 0;
      border-radius: var(--radius-card) var(--radius-card) 0 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sheet[open] {
      animation: sheet-in 360ms var(--spring);
    }
    @keyframes sheet-in {
      from {
        opacity: 0;
        transform: translateY(24px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
