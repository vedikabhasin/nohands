---
/**
 * The facts under a painting, in one fixed order everywhere: title (by the caller), original
 * availability, print availability, medium, dimensions, then the actions. Every value is from
 * the data layer. Used by the walk overlays, the painting page and the grid.
 */
import { centimetres, inches, printFrom, usd, type Work } from '@/lib/exhibition';

interface Props {
  work: Work;
  /** 'dialog' renders buttons that open the purchase sheet; 'link' renders anchors. */
  action: 'dialog' | 'link';
  href?: string;
  compact?: boolean;
}

const { work, action, href = '#buy', compact = false } = Astro.props;
const sold = work.status === 'sold';
const from = printFrom(work);
const gradId = `gilt-${work.id}-${compact ? 'c' : 'f'}`;
const primary = sold ? 'Explore print options' : 'Purchase original';
const secondary = sold ? null : from !== null ? 'Explore print options' : null;
const Tag = action === 'link' ? 'a' : 'button';
const attrs = (variant: 'original' | 'print') =>
  action === 'link'
    ? { href: `${href}${href.includes('?') ? '&' : '?'}choose=${variant}` }
    : { type: 'button' as const, 'data-open': work.id, 'data-choose': variant, 'aria-haspopup': 'dialog' as const };
---

<div class:list={['details', { 'details--compact': compact }]}>
  <ul class="facts">
    <li>
      <svg class:list={['star', { 'star--gold': work.badge === 'gold' }]} width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <defs>
          <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f3e2b0" />
            <stop offset="0.45" stop-color="#c9a85a" />
            <stop offset="1" stop-color="#9a7a2e" />
          </linearGradient>
        </defs>
        <path
          d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7L5.8 21l1.6-7L2 9.3l7.1-.7z"
          fill={work.badge === 'gold' ? `url(#${gradId})` : 'none'}
          stroke={work.badge === 'gold' ? '#8a6d2a' : 'currentColor'}
          stroke-width={work.badge === 'gold' ? '0.8' : '1.6'}
          stroke-linejoin="round"
        />
      </svg>
      {sold ? (
        <span>Original {work.kind} · <strong>Sold</strong> at {usd(work.soldAt ?? work.originalPrice)}</span>
      ) : (
        <span>One-of-a-kind original · <strong>{usd(work.originalPrice)}</strong></span>
      )}
    </li>
    {from !== null && (
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 16l3-4 2 2.5 2-3 3 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        <span>Fine art prints from <strong>{usd(from)}</strong></span>
      </li>
    )}
  </ul>
  <p class="meta">{work.medium}</p>
  <p class="meta">{inches(work.originalSize)} <span class="sep" aria-hidden="true">|</span> {centimetres(work.originalSize)}</p>
  <div class="actions">
    <Tag class="pill pill-primary" {...attrs(sold ? 'print' : 'original')}>{primary}</Tag>
    {secondary && <Tag class="link" {...attrs('print')}>{secondary}</Tag>}
  </div>
</div>

<style>
  .details {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    text-align: center;
  }
  .facts {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
    color: var(--ink);
  }
  .facts strong {
    font-weight: 600;
  }
  .facts li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }
  .star--gold {
    filter: drop-shadow(0 1px 1px rgba(90, 60, 10, 0.3));
  }
  .meta {
    font-size: 0.76rem;
    color: var(--ink-soft);
  }
  .meta:first-of-type {
    margin-top: 0.4rem;
  }
  .sep {
    margin: 0 0.4rem;
    color: var(--mute);
  }
  .actions {
    display: grid;
    gap: 0.6rem;
    justify-items: center;
    margin-top: 0.75rem;
  }
  .actions .pill {
    min-width: 13rem;
  }
  .link {
    border: 0;
    background: none;
    padding: 0.25rem 0;
    font-size: 0.84rem;
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition: color 200ms var(--ease);
  }
  .link:hover {
    color: var(--ink);
  }
  .details--compact .facts {
    font-size: 0.8rem;
  }
  .details--compact .actions .pill {
    min-width: 0;
    min-height: 2.6rem;
    padding: 0.55rem 1.2rem;
    font-size: 0.88rem;
  }
  :global(.details--left) .details,
  :global(.details--left) .actions {
    justify-items: start;
    text-align: left;
  }
  :global(.details--left) .facts li {
    justify-content: flex-start;
  }
</style>
