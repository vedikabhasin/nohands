---
/**
 * Gallery intro: an architectural space built in CSS. A receding corridor with the exhibition's
 * paintings hung along both walls, a skylight, and an arch the visitor passes through as they
 * scroll into the first painting. No sculptures, no stock imagery. The walk script sets --walk
 * (0..1) on the section; all motion is transform and opacity.
 */
import FramedPainting from '@/components/FramedPainting.astro';
import { artistName, siteName, type Exhibition } from '@/lib/exhibition';

interface Props {
  exhibition: Exhibition;
}

const { exhibition } = Astro.props;
const half = Math.ceil(exhibition.works.length / 2);
const left = exhibition.works.slice(0, half);
const right = exhibition.works.slice(half);
---

<section class="intro" data-intro style="--walk: 0; --px: 0; --py: 0;">
  <div class="stage">
    <div class="scene" aria-hidden="true">
      <div class="corridor">
        <div class="ceiling"><span class="skylight"></span></div>
        <div class="floor"></div>
        <div class="end-wall"></div>
        <div class="wall wall-l">
          {left.map((work) => (
            <div class="hung"><FramedPainting work={work} widths={[320, 480]} cap={480} sizes="18vw" hanger={false} tag={false} /></div>
          ))}
        </div>
        <div class="wall wall-r">
          {right.map((work) => (
            <div class="hung"><FramedPainting work={work} widths={[320, 480]} cap={480} sizes="18vw" hanger={false} tag={false} /></div>
          ))}
        </div>
      </div>
      <div class="arch"></div>
    </div>

    <div class="copy">
      <p class="eyebrow">{siteName} by {artistName}</p>
      <h1 class="title">{exhibition.title}</h1>
      <p class="lede">{exhibition.works.length} original paintings on paper, shown one at a time.</p>
      <button class="pill pill-primary" type="button" data-start>Start the walk</button>
    </div>
    <p class="hint eyebrow">Scroll</p>
  </div>
</section>

<style>
  .intro {
    position: relative;
    height: 200svh;
    scroll-snap-align: start;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    isolation: isolate;
    background: var(--ground);
  }

  .scene {
    --cw: min(34vw, 260px); /* half corridor width */
    --ch: min(32svh, 300px); /* half corridor height */
    --cl: 1700px; /* corridor length */
    position: absolute;
    inset: 0;
    perspective: 820px;
    perspective-origin: calc(50% + var(--px) * 3%) calc(46% + var(--py) * 2%);
    opacity: calc(1 - var(--walk) * var(--walk) * 0.9);
  }
  .corridor {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    transform: translate3d(0, 0, calc(var(--walk) * 1150px));
    will-change: transform;
  }
  .corridor > * {
    position: absolute;
    left: 0;
    top: 0;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  .wall {
    width: var(--cl);
    height: calc(var(--ch) * 2);
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    padding: 0 6%;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 40%, rgba(20, 20, 19, 0.06)),
      var(--surface);
  }
  .wall-l {
    transform: translate3d(-50%, -50%, 0) translate3d(calc(-1 * var(--cw)), 0, calc(-1 * var(--cl) / 2)) rotateY(90deg);
  }
  .wall-r {
    transform: translate3d(-50%, -50%, 0) translate3d(var(--cw), 0, calc(-1 * var(--cl) / 2)) rotateY(-90deg);
    flex-direction: row-reverse;
  }
  .hung {
    width: 11%;
    filter: drop-shadow(0 10px 10px rgba(20, 20, 19, 0.25));
  }
  .floor {
    width: calc(var(--cw) * 2);
    height: var(--cl);
    transform: translate3d(-50%, -50%, 0) translate3d(0, var(--ch), calc(-1 * var(--cl) / 2)) rotateX(90deg);
    background: linear-gradient(to top, var(--ground-deep), var(--ground-low) 60%, #cfcabf);
  }
  .ceiling {
    width: calc(var(--cw) * 2);
    height: var(--cl);
    transform: translate3d(-50%, -50%, 0) translate3d(0, calc(-1 * var(--ch)), calc(-1 * var(--cl) / 2)) rotateX(-90deg);
    background: linear-gradient(to top, #f8f7f4, #efede8);
  }
  .skylight {
    position: absolute;
    left: 50%;
    top: 14%;
    width: 46%;
    height: 22%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, #fffdf7, #fff7e0 60%, rgba(255, 247, 224, 0));
    box-shadow: 0 0 120px 60px rgba(255, 248, 225, 0.9);
  }
  .end-wall {
    width: calc(var(--cw) * 2);
    height: calc(var(--ch) * 2);
    transform: translate3d(-50%, -50%, 0) translate3d(0, 0, calc(-1 * var(--cl)));
    background: radial-gradient(60% 50% at 50% 30%, #ffffff, var(--surface) 70%);
  }
  /* The arch: everything outside its opening is masked by its enormous shadow in the ground colour. */
  .arch {
    position: absolute;
    left: 50%;
    top: 9%;
    width: min(62vw, 48svh);
    height: 120svh;
    border-radius: min(31vw, 24svh) min(31vw, 24svh) 0 0;
    transform: translate3d(-50%, 0, 0) scale(calc(1 + var(--walk) * 2.4));
    transform-origin: 50% 46%;
    box-shadow:
      0 0 0 120vmax var(--ground),
      inset 0 0 0 clamp(6px, 1vw, 12px) #f6f4ef,
      inset 0 0 60px rgba(20, 20, 19, 0.12);
    will-change: transform;
  }

  .copy {
    position: relative;
    z-index: 2;
    padding: 2rem 2.5rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(236, 234, 229, 0.92), rgba(236, 234, 229, 0.75) 60%, rgba(236, 234, 229, 0));
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    text-align: center;
    opacity: calc(1 - var(--walk) * 2.2);
    transform: translate3d(0, calc(var(--walk) * -60px), 0);
    pointer-events: none;
  }
  .intro.is-copy .copy {
    pointer-events: auto;
  }
  .title {
    font-size: clamp(2.6rem, 9vw, 5.4rem);
    letter-spacing: -0.02em;
  }
  .lede {
    max-width: 24rem;
    color: var(--ink-soft);
  }
  .copy .pill {
    margin-top: 0.75rem;
  }
  .hint {
    position: absolute;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: calc(1 - var(--walk) * 4);
  }

  @media (max-width: 899px) {
    .scene {
      --cw: 42vw;
      --ch: 24svh;
      --cl: 1300px;
      perspective: 640px;
    }
    .hung {
      width: 12%;
    }
    .arch {
      width: 82vw;
      border-radius: 41vw 41vw 0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro {
      height: auto;
      min-height: 100svh;
    }
    .stage {
      position: relative;
    }
    .copy {
      pointer-events: auto;
    }
  }
</style>
