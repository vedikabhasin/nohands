---
/**
 * The walk: one continuous corridor built with CSS 3D, assembled from short bays (one per
 * painting plus an entry and an end bay). Each bay is four small planes, so no layer is ever
 * huge or extends far behind the camera. Paintings hang centred on their bay's wall, alternating
 * left and right, Water Droplets first on the left by the door. The walk script sets the bay
 * positions and moves the camera; it also lays out the overlays. Reduced motion renders a flat
 * list instead.
 */
import FramedPainting from '@/components/FramedPainting.astro';
import PaintingDetails from '@/components/PaintingDetails.astro';
import type { Exhibition } from '@/lib/exhibition';

interface Props {
  exhibition: Exhibition;
}

const { exhibition } = Astro.props;
const stops = exhibition.works.map((work, i) => ({ work, side: i % 2 === 0 ? -1 : 1 }));
---

<div class="walk" data-walk={exhibition.id} data-count={stops.length}>
  <div class="stage" data-stage>
    <div class="scene" data-scene aria-hidden="true">
      <div class="corridor">
        <div class="bay bay--entry" data-bay="entry">
          <div class="plane wall wall-l"></div>
          <div class="plane wall wall-r"></div>
          <div class="plane floor"></div>
          <div class="plane ceiling ceiling--plain"></div>
        </div>
        {stops.map(({ work, side }) => (
          <div class="bay" data-bay={work.index}>
            <div class="plane wall wall-l">
              {side < 0 && (
                <div class="hung" data-hung={work.id} data-index={work.index} data-side="-1" data-ratio={work.image.width / work.image.height} data-long={Math.max(work.originalSize.width, work.originalSize.height)}>
                  <FramedPainting work={work} eager sizes="(min-width: 900px) 40vw, 84vw" />
                </div>
              )}
            </div>
            <div class="plane wall wall-r">
              {side > 0 && (
                <div class="hung" data-hung={work.id} data-index={work.index} data-side="1" data-ratio={work.image.width / work.image.height} data-long={Math.max(work.originalSize.width, work.originalSize.height)}>
                  <FramedPainting work={work} eager sizes="(min-width: 900px) 40vw, 84vw" />
                </div>
              )}
            </div>
            <div class="plane floor"></div>
            <div class="plane ceiling"></div>
          </div>
        ))}
        <div class="bay bay--end" data-bay="end">
          <div class="plane wall wall-l"></div>
          <div class="plane wall wall-r"></div>
          <div class="plane floor"></div>
          <div class="plane ceiling ceiling--plain"></div>
          <div class="plane end-wall"></div>
        </div>
      </div>
    </div>

    <div class="overlays">
      {stops.map(({ work }) => (
        <div class="panel" data-panel={work.id} style="--h: 0;">
          <h2 class="title title--mobile">{work.title}</h2>
          <div class="panel-details" data-details>
            <h2 class="title title--desktop" aria-hidden="true">{work.title}</h2>
            <PaintingDetails work={work} action="dialog" />
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Reduced motion: the same paintings and facts as a flat list. Images here only load when shown. -->
  <ol class="static-list" aria-label="Paintings">
    {stops.map(({ work }) => (
      <li class="static-item" id={`stop-${work.id}`}>
        <h2 class="title">{work.title}</h2>
        <div class="static-frame" style={`--ratio: ${work.image.width} / ${work.image.height};`}>
          <FramedPainting work={work} sizes="(min-width: 900px) 40vw, 84vw" />
        </div>
        <PaintingDetails work={work} action="dialog" />
      </li>
    ))}
  </ol>
</div>

<style>
  .walk {
    position: relative;
    /* height is set by the walk script */
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    perspective: var(--p, 900px);
    perspective-origin: 50% 50%;
    background: var(--ground);
    isolation: isolate;
  }
  .scene {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .corridor,
  .bay {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }
  /* Every plane is positioned from the scene origin: centre it, move it to its bay, rotate. */
  .plane {
    position: absolute;
    left: 0;
    top: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: flat;
  }
  .wall {
    width: var(--len);
    height: calc(var(--ch) * 2);
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 38%, rgba(20, 20, 19, 0.05)),
      var(--surface);
  }
  .wall-l {
    transform: translate3d(-50%, -50%, 0) translate3d(calc(-1 * var(--cw)), 0, var(--zc)) rotateY(90deg);
  }
  .wall-r {
    transform: translate3d(-50%, -50%, 0) translate3d(var(--cw), 0, var(--zc)) rotateY(-90deg);
  }
  .hung {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--pw);
    transform: translate(-50%, -50%);
  }
  .floor {
    width: calc(var(--cw) * 2);
    height: var(--len);
    transform: translate3d(-50%, -50%, 0) translate3d(0, var(--ch), var(--zc)) rotateX(90deg);
    background:
      linear-gradient(to right, rgba(20, 20, 19, 0.05), rgba(20, 20, 19, 0) 12%, rgba(20, 20, 19, 0) 88%, rgba(20, 20, 19, 0.05)),
      var(--ground-deep);
  }
  .ceiling {
    width: calc(var(--cw) * 2);
    height: var(--len);
    transform: translate3d(-50%, -50%, 0) translate3d(0, calc(-1 * var(--ch)), var(--zc)) rotateX(-90deg);
    background:
      radial-gradient(38% 16% at 50% 50%, #fffdf4 0%, #fff6dc 45%, rgba(255, 246, 220, 0) 100%),
      #f4f2ee;
  }
  .ceiling--plain {
    background: #f4f2ee;
  }
  .end-wall {
    width: calc(var(--cw) * 2);
    height: calc(var(--ch) * 2);
    transform: translate3d(-50%, -50%, 0) translate3d(0, 0, var(--zend));
    background: radial-gradient(60% 50% at 50% 30%, #ffffff, var(--surface) 70%);
  }

  /* 2D overlays: one panel per painting, shown while the camera holds on it. */
  .overlays {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .panel {
    position: absolute;
    inset: 0;
    opacity: var(--h);
    pointer-events: none;
  }
  .panel.is-view .panel-details {
    pointer-events: auto;
  }
  .title {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0;
    text-align: center;
  }
  .title--mobile {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    top: calc(var(--header-h) + 0.1rem);
    transform: translate3d(0, calc((1 - var(--h)) * -8px), 0);
  }
  .title--desktop {
    display: none;
  }
  .panel-details {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--details-top, 62%);
    padding: 0 1.25rem;
    transform: translate3d(0, calc((1 - var(--h)) * 14px), 0);
  }

  @media (min-width: 900px) {
    .title--mobile {
      display: none;
    }
    .title--desktop {
      display: block;
      font-size: 1.35rem;
      text-align: left;
      margin-bottom: 0.9rem;
    }
    .panel-details {
      left: auto;
      right: clamp(2rem, 7vw, 8rem);
      top: 50%;
      width: min(30rem, 38vw);
      padding: 0;
      transform: translate3d(calc((1 - var(--h)) * 14px), -50%, 0);
    }
    .panel-details :global(.details) {
      justify-items: start;
      text-align: left;
    }
    .panel-details :global(.facts li) {
      justify-content: flex-start;
    }
  }

  .static-list {
    display: none;
    margin: 0;
    padding: calc(var(--header-h) + 1rem) 1.25rem 3rem;
    list-style: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .stage {
      display: none;
    }
    .walk {
      height: auto !important;
    }
    .static-list {
      display: grid;
      gap: 4rem;
    }
    .static-item {
      display: grid;
      gap: 1.25rem;
      justify-items: center;
      scroll-margin-top: var(--header-h);
    }
    .static-item .title {
      position: static;
      transform: none;
      margin: 0;
    }
    .static-frame {
      width: min(84vw, calc(50svh * (var(--ratio))), 36rem);
      margin-top: 4rem;
    }
  }
</style>
